{
	"name": "termost",
	"version": "1.9.2",
	"description": "Get the most of your terminal",
	"keywords": [
		"args",
		"argument",
		"cli",
		"command",
		"message",
		"option",
		"question",
		"task",
		"terminal"
	],
	"homepage": "https://github.com/adbayb/termost/tree/main/termost#readme",
	"bugs": "https://github.com/adbayb/termost/issues",
	"license": "MIT",
	"author": "Ayoub Adib <adbayb@gmail.com> (https://twitter.com/adbayb)",
	"repository": {
		"type": "git",
		"url": "git@github.com:adbayb/termost.git",
		"directory": "termost"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"source": "./src/index.ts",
		"types": "./dist/index.d.ts",
		"require": "./dist/index.cjs",
		"import": "./dist/index.mjs",
		"default": "./dist/index.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "quickbundle build",
		"prepublishOnly": "pnpm build",
		"start": "pnpm watch",
		"test": "vitest --test-timeout=20000",
		"watch": "quickbundle watch"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0"
	},
	"devDependencies": {
		"quickbundle": "3.1.1",
		"vitest": "4.1.11"
	}
}
